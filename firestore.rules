rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Site Config
    match /config/site {
      allow read: if true;
      allow write: if true; // Temporary permissive for sync between devices
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true; // Temporary permissive for sync
    }
  }
}
